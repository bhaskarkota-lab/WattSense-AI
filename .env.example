# ==============================================================================
# WattSense AI™ — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Options: development, test, demo, production
# CRITICAL: In "production", ALLOW_SQLITE_FALLBACK is strictly disabled.
# The application will fail-closed immediately if PostgreSQL cannot be reached.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database & PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Target PostgreSQL database URL format:
#   postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
#
# LOCAL SETUP INSTRUCTIONS:
#   1. Install PostgreSQL 14+ (PostgreSQL 18 is installed locally).
#   2. Connect to psql: psql -U postgres
#   3. Create database: CREATE DATABASE electricity_wastage_db;
#   4. Replace "your_secure_password" below with your PostgreSQL superuser or application password.
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/electricity_wastage_db

# Fallback Settings:
# In development/test/demo, if PostgreSQL connection fails, the application falls
# back to SQLite to preserve developer workflow. In production, this MUST be False.
ALLOW_SQLITE_FALLBACK=True
SQLITE_DB_PATH=electricity_wastage_dev.db

# Production Connection Pool Tuning (PostgreSQL QueuePool):
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# ------------------------------------------------------------------------------
# 3. Application & API Settings
# ------------------------------------------------------------------------------
API_V1_STR=/api/v1
PROJECT_NAME="Smart Electricity Wastage Detection & Consumption Intelligence"

# ------------------------------------------------------------------------------
# 4. Security Configuration
# ------------------------------------------------------------------------------
# In production, both SECRET_KEY and ADMIN_SECRET_KEY must be overridden
# with cryptographically random keys (min 32 characters for SECRET_KEY, min 16 for ADMIN).
SECRET_KEY=replace-with-a-random-64-char-hex-secret-in-production
ADMIN_SECRET_KEY=replace-with-a-strong-admin-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Restricts unverified consumer lookups strictly to synthetic test accounts
ENFORCE_DEMO_MODE=True

# ------------------------------------------------------------------------------
# 5. Network & CORS Whitelist
# ------------------------------------------------------------------------------
ALLOWED_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 6. File & Storage Paths (Relative to project root)
# ------------------------------------------------------------------------------
DATA_DIR=data
REPORTS_DIR=reports
MODELS_DIR=models
