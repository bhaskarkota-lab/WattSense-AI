# ==============================================================================
# WattSense AI™ — Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# In production, ALLOW_SQLITE_FALLBACK is strictly forbidden and rejected on startup.
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. Managed Database & PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Secure production PostgreSQL connection string (prefer managed Cloud SQL, RDS, or private VPC instance)
DATABASE_URL=postgresql+psycopg2://appuser:STRONG_PRODUCTION_DB_PASSWORD@postgres-host.internal:5432/electricity_wastage_db

# Strictly False in production — application will fail-closed if PostgreSQL is unreachable
ALLOW_SQLITE_FALLBACK=False

# Production Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# ------------------------------------------------------------------------------
# 3. Security Credentials (MANDATORY CRYPTOGRAPHIC SECRETS)
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHARACTER_RANDOM_HEX_SECRET_FOR_SESSION_SIGNING

# Generate with: python -c "import secrets; print(secrets.token_hex(20))"
ADMIN_SECRET_KEY=REPLACE_WITH_STRONG_UNIQUE_ADMIN_SECRET_KEY_MIN_16_CHARS

# Session expiration
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Restrict unverified customer access strictly to demonstration accounts
ENFORCE_DEMO_MODE=True

# ------------------------------------------------------------------------------
# 4. Production Domain Whitelist & CORS Policy
# ------------------------------------------------------------------------------
# JSON array of permitted domains (e.g. HTTPS domain of your production frontend/reverse proxy)
ALLOWED_CORS_ORIGINS=["https://wattsense.ai","https://app.wattsense.ai"]

# ------------------------------------------------------------------------------
# 5. Core Paths & Storage
# ------------------------------------------------------------------------------
API_V1_STR=/api/v1
PROJECT_NAME="Smart Electricity Wastage Detection & Consumption Intelligence"
DATA_DIR=data
REPORTS_DIR=reports
MODELS_DIR=models
